# Copy to .env and fill in the secrets:  cp .env.example .env
# Generate secrets with:  openssl rand -hex 32

# App
NODE_ENV=development
PORT=3000

# Database (PostgreSQL — docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=limone
DB_USERNAME=root
DB_PASSWORD=change-me

# JWT (Phase 0 — docs/PHASE_0_FOUNDATION.md §7)
JWT_ACCESS_SECRET=change-me-64-hex-chars
JWT_REFRESH_SECRET=change-me-64-hex-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=2h

# pgAdmin (optional, docker compose --profile tools up -d pgadmin)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@limone.local
PGADMIN_PASSWORD=change-me

# Nginx (reverse proxy)
NGINX_PORT=8080
